export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal<T...> = {
	Connect: (self: Signal<T...>, callback: (T...) -> ()) -> Connection,
	Once: (self: Signal<T...>, callback: (T...) -> ()) -> Connection,
	Fire: (self: Signal<T...>, T...) -> (),
	Destroy: (self: Signal<T...>) -> (),
}

export type Color = Color3 | string | { Color3 | string } | ColorSequence

export type Icon = string
	| number
	| { Type: "Image" | "Url" | "Svg" | "Vector" | "File", Source: string?, Tint: boolean?, Name: string? }

export type Theme = {
	Background: Color3,
	SecondaryBackground: Color3,
	TertiaryBackground: Color3,
	Text: Color3,
	MutedText: Color3,
	Accent: Color3,
	AccentText: Color3,
	Border: Color3,
	Hover: Color3,
	Pressed: Color3,
	Success: Color3?,
	Warning: Color3?,
	Error: Color3?,
	Info: Color3?,
	Overlay: Color3?,
	AcrylicTint: Color3?,
	AcrylicGradient: ColorSequence?,
	AcrylicNoise: number?,
	AcrylicTransparency: number?,
	ElementTransparency: number?,
	ComponentTransparency: number?,
	ComponentStrokeTransparency: number?,
	Base: string?,
}

export type WindowConfig = {
	Title: string,
	SubTitle: string?,
	Icon: Icon?,
	IconColor: Color?,
	IconCorner: (number | "Full")?,
	TitleColor: Color?,
	TitleGradient: { Color }?,
	SubTitleColor: Color?,
	Footer: string?,
	FooterColor: Color?,
	Size: UDim2?,
	Position: UDim2?,
	MinSize: Vector2?,
	MaxSize: Vector2?,
	TabWidth: number?,
	Theme: string?,
	Font: (Enum.Font | Font | string)?,
	Scale: number?,
	Acrylic: boolean?,
	Blur: boolean?,
	Glass: boolean?,
	Resize: boolean?,
	Search: boolean?,
	CloseButton: boolean?,
	CollapseButton: boolean?,
	MaximizeButton: boolean?,
	ConfirmClose: boolean?,
	RestoreButton: boolean?,
	RestoreText: string?,
	RestorePosition: UDim2?,
	RestoreDraggable: boolean?,
	PopupsOutside: boolean?,
	BackgroundImage: string?,
	BackgroundImageTransparency: number?,
	MinimizeKey: Enum.KeyCode?,
	SaveFile: string?,
	DisplayOrder: number?,
	OnClose: (() -> ())?,
}

export type TabConfig = {
	Title: string,
	Icon: Icon?,
	IconColor: Color?,
	IconSize: number?,
	TitleColor: Color?,
	TitleGradient: { Color }?,
	SelectedColor: Color?,
	IndicatorColor: Color?,
	Gap: number?,
}

export type SectionConfig = {
	Title: string,
	Icon: Icon?,
	IconColor: Color?,
	Color: Color?,
	Gradient: { Color }?,
	LineColor: Color?,
	Line: boolean?,
	Collapsible: boolean?,
	Collapsed: boolean?,
	Gap: number?,
}

export type BaseConfig = {
	Title: string?,
	Description: string?,
	Icon: Icon?,
	IconColor: Color?,
	TitleColor: Color?,
	TitleGradient: { Color }?,
	DescriptionColor: Color?,
	DescriptionGradient: { Color }?,
	EditableTitle: boolean?,
	EditableDescription: boolean?,
	OnTitleChanged: ((string) -> ())?,
	OnDescriptionChanged: ((string) -> ())?,
	Tooltip: string?,
	Visible: boolean?,
	Enabled: boolean?,
	RichText: boolean?,
}

export type ButtonConfig = BaseConfig & { Callback: (() -> ())?, Arrow: Icon?, ArrowColor: Color? }

export type ToggleConfig = BaseConfig & {
	Default: boolean?,
	Color: Color?,
	KnobColor: Color?,
	Callback: ((boolean) -> ())?,
}

export type SliderConfig = BaseConfig & {
	Min: number,
	Max: number,
	Default: number?,
	Increment: number?,
	Rounding: number?,
	Suffix: string?,
	Color: Color?,
	Callback: ((number) -> ())?,
}

export type DropdownValue = string | { Value: string?, Title: string?, Icon: Icon?, Color: Color? }

export type DropdownConfig = BaseConfig & {
	Values: { DropdownValue },
	Multi: boolean?,
	Default: (string | number | { string } | { [string]: boolean })?,
	Placeholder: string?,
	Editable: boolean?,
	Creatable: boolean?,
	Removable: boolean?,
	Searchable: boolean?,
	MaxVisible: number?,
	PopupWidth: number?,
	Width: number?,
	AddText: string?,
	CheckIcon: Icon?,
	CheckColor: Color?,
	Icons: { [string]: Icon }?,
	Colors: { [string]: Color }?,
	Callback: ((any) -> ())?,
	OnValuesChanged: (({ string }) -> ())?,
	OnAdd: ((string) -> ())?,
	OnRemove: ((string) -> ())?,
	OnRename: ((string, string) -> ())?,
}

export type InputConfig = BaseConfig & {
	Default: string?,
	Placeholder: string?,
	MaxLength: number?,
	Numeric: boolean?,
	Live: boolean?,
	ClearButton: boolean?,
	Width: number?,
	Height: number?,
	Validate: ((string) -> boolean)?,
	Callback: ((string) -> ())?,
}

export type KeybindConfig = BaseConfig & {
	Default: (Enum.KeyCode | Enum.UserInputType | string)?,
	Mode: ("Press" | "Toggle" | "Hold" | "Always")?,
	Callback: ((any) -> ())?,
	ChangedCallback: ((Enum.KeyCode | Enum.UserInputType) -> ())?,
	ModeCallback: ((string) -> ())?,
}

export type ColorpickerConfig = BaseConfig & {
	Default: (Color3 | string)?,
	Transparency: number?,
	Palette: boolean?,
	Callback: ((Color3, number) -> ())?,
}

export type NotificationConfig = {
	Title: string?,
	Content: string?,
	Type: ("Info" | "Success" | "Warning" | "Error")?,
	Duration: number?,
	Icon: Icon?,
	IconColor: Color?,
	Color: Color?,
	TitleColor: Color?,
	ContentColor: Color?,
	Progress: boolean?,
	Closable: boolean?,
	Buttons: { { Title: string?, Callback: (() -> ())?, Primary: boolean?, Color: Color? } }?,
}

export type DialogConfig = {
	Title: string,
	Content: string?,
	Icon: Icon?,
	IconColor: Color?,
	TitleColor: Color?,
	ContentColor: Color?,
	Width: number?,
	Input: (boolean | string)?,
	InputDefault: string?,
	Placeholder: string?,
	Buttons: { { Title: string, Callback: ((string?) -> ())?, Primary: boolean?, Color: Color?, KeepOpen: boolean? } }?,
}

export type StatusBarConfig = {
	Title: string?,
	Icon: Icon?,
	IconColor: Color?,
	TitleColor: Color?,
	ValueColor: Color?,
	Position: (string | UDim2)?,
	Offset: Vector2?,
	Fps: boolean?,
	Ping: boolean?,
	Players: boolean?,
	Memory: boolean?,
	Clock: boolean?,
	Session: boolean?,
	Place: boolean?,
	Fields: { { Key: string, Label: string?, Icon: Icon?, Value: (() -> any)? } }?,
	Labels: boolean?,
	Icons: boolean?,
	Compact: boolean?,
	Separator: string?,
	Interval: number?,
	Height: number?,
	Radius: (number | "Full")?,
	MinWidth: number?,
	MaxWidth: number?,
	PaddingX: number?,
	TextSize: number?,
	Background: Color?,
	Border: Color?,
	Transparency: number?,
	Draggable: boolean?,
	IgnoreInset: boolean?,
	ClockFormat: string?,
	MaxPlayers: boolean?,
	DisplayOrder: number?,
}

export type Component = {
	Kind: string,
	Id: string?,
	Frame: Frame?,
	Enabled: boolean,
	Visible: boolean,
	Changed: Signal<...any>,
	TextChanged: Signal<string, string>,
	GetValue: (self: Component) -> any,
	SetValue: (self: Component, value: any) -> Component,
	OnChanged: (self: Component, callback: (...any) -> ()) -> Connection,
	SetCallback: (self: Component, callback: (...any) -> ()) -> Component,
	GetTitle: (self: Component) -> string,
	GetDescription: (self: Component) -> string,
	SetTitle: (self: Component, text: string) -> Component,
	SetDescription: (self: Component, text: string) -> Component,
	SetTitleColor: (self: Component, color: Color) -> Component,
	SetDescriptionColor: (self: Component, color: Color) -> Component,
	SetTitleGradient: (self: Component, stops: { Color }) -> Component,
	SetDescriptionGradient: (self: Component, stops: { Color }) -> Component,
	SetTextColor: (self: Component, color: Color) -> Component,
	SetEditable: (self: Component, kind: "Title" | "Description", enabled: boolean) -> Component,
	Edit: (self: Component, kind: ("Title" | "Description")?) -> Component,
	SetIcon: (self: Component, icon: Icon?) -> Component,
	SetIconColor: (self: Component, color: Color) -> Component,
	SetVisible: (self: Component, visible: boolean) -> Component,
	SetEnabled: (self: Component, enabled: boolean) -> Component,
	SetTooltip: (self: Component, text: string) -> Component,
	SetLayoutOrder: (self: Component, order: number) -> Component,
	Flash: (self: Component, token: string?) -> Component,
	Destroy: (self: Component) -> (),
}

export type Dropdown = Component & {
	Values: { string },
	Multi: boolean,
	ValuesChanged: Signal<{ string }>,
	GetValues: (self: Dropdown) -> { string },
	GetSelected: (self: Dropdown) -> any,
	GetLabel: (self: Dropdown, name: string) -> string,
	SetValues: (self: Dropdown, values: { DropdownValue }) -> Dropdown,
	AddValue: (self: Dropdown, name: string, options: { Title: string?, Icon: Icon?, Color: Color }?) -> Dropdown,
	RemoveValue: (self: Dropdown, name: string) -> Dropdown,
	RenameValue: (self: Dropdown, old: string, new: string) -> Dropdown,
	SetOption: (self: Dropdown, name: string, options: { Title: string?, Icon: Icon?, Color: Color }) -> Dropdown,
	SelectAll: (self: Dropdown) -> Dropdown,
	SelectNone: (self: Dropdown) -> Dropdown,
	Clear: (self: Dropdown) -> Dropdown,
	Open: (self: Dropdown) -> Dropdown,
	Close: (self: Dropdown) -> Dropdown,
}

export type Container = {
	Window: Window,
	Container: Frame,
	AddButton: (self: Container, id: (string | ButtonConfig)?, config: ButtonConfig?) -> Component,
	AddToggle: (self: Container, id: (string | ToggleConfig)?, config: ToggleConfig?) -> Component,
	AddSlider: (self: Container, id: (string | SliderConfig)?, config: SliderConfig?) -> Component,
	AddDropdown: (self: Container, id: (string | DropdownConfig)?, config: DropdownConfig?) -> Dropdown,
	AddMultiDropdown: (self: Container, id: (string | DropdownConfig)?, config: DropdownConfig?) -> Dropdown,
	AddInput: (self: Container, id: (string | InputConfig)?, config: InputConfig?) -> Component,
	AddKeybind: (self: Container, id: (string | KeybindConfig)?, config: KeybindConfig?) -> Component,
	AddColorpicker: (self: Container, id: (string | ColorpickerConfig)?, config: ColorpickerConfig?) -> Component,
	AddParagraph: (self: Container, config: BaseConfig) -> Component,
	AddLabel: (self: Container, config: BaseConfig) -> Component,
	AddDivider: (self: Container, config: { Title: string?, Color: Color?, Height: number? }?) -> Component,
	[string]: any,
}

export type Section = Container & {
	Title: string,
	SetTitle: (self: Section, text: string) -> Section,
	SetColor: (self: Section, color: Color) -> Section,
	SetIcon: (self: Section, icon: Icon?) -> Section,
	Collapse: (self: Section) -> Section,
	Expand: (self: Section) -> Section,
	Toggle: (self: Section) -> Section,
	IsCollapsed: (self: Section) -> boolean,
	SetVisible: (self: Section, visible: boolean) -> Section,
	Destroy: (self: Section) -> (),
}

export type SubTab = Container & {
	Title: string,
	Select: (self: SubTab) -> SubTab,
	SetTitle: (self: SubTab, text: string) -> SubTab,
	SetIcon: (self: SubTab, icon: Icon?) -> SubTab,
	AddSection: (self: SubTab, config: string | SectionConfig) -> Section,
	Destroy: (self: SubTab) -> (),
}

export type Tab = Container & {
	Title: string,
	SubTabs: { SubTab },
	Select: (self: Tab) -> Tab,
	Deselect: (self: Tab) -> Tab,
	SetTitle: (self: Tab, text: string) -> Tab,
	SetTitleColor: (self: Tab, color: Color) -> Tab,
	SetIcon: (self: Tab, icon: Icon?) -> Tab,
	SetIconColor: (self: Tab, color: Color) -> Tab,
	SetVisible: (self: Tab, visible: boolean) -> Tab,
	AddSection: (self: Tab, config: string | SectionConfig) -> Section,
	AddSubTab: (self: Tab, config: string | TabConfig) -> SubTab,
	SelectSubTab: (self: Tab, target: SubTab | number | string) -> Tab,
	GetSubTab: (self: Tab, title: string) -> SubTab?,
	Destroy: (self: Tab) -> (),
}

export type Window = {
	Options: { [string]: Component },
	Tabs: { Tab },
	OnDestroy: Signal<()>,
	MinimizedChanged: Signal<boolean>,
	AddTab: (self: Window, config: string | TabConfig) -> Tab,
	SelectTab: (self: Window, target: Tab | number | string) -> Window,
	GetTab: (self: Window, title: string) -> Tab?,
	SetTitle: (self: Window, text: string) -> Window,
	SetTitleColor: (self: Window, color: Color) -> Window,
	SetSubTitle: (self: Window, text: string?) -> Window,
	SetIcon: (self: Window, icon: Icon?) -> Window,
	SetFooter: (self: Window, text: string) -> Window,
	SetTheme: (self: Window, name: string) -> boolean,
	SetSearchEnabled: (self: Window, enabled: boolean) -> Window,
	SetBackgroundImage: (self: Window, image: string, transparency: number?) -> Window,
	SetAcrylic: (self: Window, enabled: boolean) -> Window,
	SetTransparency: (self: Window, value: number) -> Window,
	SetMinimizeKey: (self: Window, key: Enum.KeyCode?) -> Window,
	SetCollapsed: (self: Window, value: boolean) -> Window,
	ToggleCollapsed: (self: Window) -> Window,
	SetMaximized: (self: Window, value: boolean) -> Window,
	ToggleMaximized: (self: Window) -> Window,
	Minimize: (self: Window) -> Window,
	Restore: (self: Window) -> Window,
	Toggle: (self: Window) -> Window,
	IsMinimized: (self: Window) -> boolean,
	Notify: (self: Window, config: NotificationConfig) -> any,
	CreateDialog: (self: Window, config: DialogConfig) -> any,
	Save: (self: Window, name: string?) -> (boolean, string?),
	Load: (self: Window, name: string?) -> (boolean, string?),
	SetAutoSave: (self: Window, enabled: boolean, name: string?) -> boolean,
	Destroy: (self: Window) -> (),
}

export type StatusBar = {
	Frame: Frame,
	Refresh: (self: StatusBar) -> (),
	AddField: (self: StatusBar, key: string, options: { Label: string?, Icon: Icon?, Value: (() -> any)?, Text: string? }?) -> StatusBar,
	SetField: (self: StatusBar, key: string, value: any) -> StatusBar,
	RemoveField: (self: StatusBar, key: string) -> StatusBar,
	SetTitle: (self: StatusBar, text: string) -> StatusBar,
	SetTitleColor: (self: StatusBar, color: Color) -> StatusBar,
	SetIcon: (self: StatusBar, icon: Icon?) -> StatusBar,
	SetPosition: (self: StatusBar, value: string | UDim2, offset: Vector2?) -> StatusBar,
	SetInterval: (self: StatusBar, seconds: number) -> StatusBar,
	SetCompact: (self: StatusBar, value: boolean) -> StatusBar,
	SetSeparator: (self: StatusBar, text: string) -> StatusBar,
	SetVisible: (self: StatusBar, value: boolean) -> StatusBar,
	Show: (self: StatusBar) -> StatusBar,
	Hide: (self: StatusBar) -> StatusBar,
	Toggle: (self: StatusBar) -> StatusBar,
	IsVisible: (self: StatusBar) -> boolean,
	GetFps: (self: StatusBar) -> number,
	GetPing: (self: StatusBar) -> number?,
	Destroy: (self: StatusBar) -> (),
}

return {}
